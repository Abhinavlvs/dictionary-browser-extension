{
  "manifest_version": 3,
  "name": "Dictionary Lookup",
  "version": "0.1.0",
  "description": "Select an English word to see its meaning. Right-click to search Merriam-Webster.",
  "permissions": ["contextMenus", "storage"],
  "action": { "default_title": "Dictionary Lookup: toggle on this site" },
  "host_permissions": ["https://freedictionaryapi.com/*"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["lib/parse.js", "lib/words.js", "lib/config.js", "lib/sites.js", "lib/lookup.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/parse.js", "lib/words.js", "lib/sites.js", "lib/cardmodel.js", "card.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "icons": { "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "browser_specific_settings": { "gecko": { "id": "dictionary-lookup@local", "strict_min_version": "127.0" } }
}
