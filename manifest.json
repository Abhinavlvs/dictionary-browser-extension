{
  "manifest_version": 3,
  "name": "Dictionary Lookup",
  "version": "0.2.0",
  "description": "Select an English word to see its meaning. Right-click to search Merriam-Webster.",
  "permissions": [
    "contextMenus",
    "storage"
  ],
  "action": {
    "default_title": "Dictionary Lookup",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "host_permissions": [
    "https://freedictionaryapi.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/parse.js",
        "lib/words.js",
        "lib/sites.js",
        "lib/cardmodel.js",
        "card.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
